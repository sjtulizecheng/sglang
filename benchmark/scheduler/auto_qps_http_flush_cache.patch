+def flush_http_cache(base_url, timeout=30):
+    """Start each HTTP trial from an empty server cache, including repeats."""
+    headers = {}
+    if os.getenv("OPENAI_API_KEY"):
+        headers["Authorization"] = "Bearer " + os.environ["OPENAI_API_KEY"]
+    opener = build_opener(ProxyHandler({}))
+    with opener.open(Request(base_url + "/v1/loads", headers=headers), timeout=timeout) as response:
+        loads = json.loads(response.read())["loads"]
+    if any(load["num_running_reqs"] or load["num_waiting_reqs"] for load in loads):
+        raise RuntimeError("Cannot flush cache while model requests are still running or queued")
+    with opener.open(Request(base_url + "/flush_cache", headers=headers, method="POST"), timeout=timeout) as response:
+        if response.status != 200:
+            raise RuntimeError("Cache flush did not return HTTP 200")
+        message = response.read().decode()
+    return {"completed_at": datetime.now(timezone.utc).isoformat(),
+            "status": 200, "response": message}


