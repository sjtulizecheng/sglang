+class HttpCacheTests(unittest.TestCase):
+    def run_with_flush(self, directory, flush, run_child):
+        cases = directory / "cases.jsonl"
+        cases.write_text("\n".join(json.dumps({
+            "messages": [{"role": "user", "content": str(i)}], "max_tokens": 16
+        }) for i in range(100)) + "\n")
+        with patch.object(auto_qps, "flush_http_cache", side_effect=flush), patch.object(
+            auto_qps, "run_child", side_effect=run_child
+        ) as runner:
+            result = auto_qps.main([
+                "--runner", "http", "--disable-stream", "--flush-cache",
+                "--base-url", "http://127.0.0.1:1", "--served-model", "test",
+                "--cases", str(cases), "--report-dir", str(directory / "reports"),
+                "--num-prompts", "100", "--start-qps", "1", "--min-qps", "1",
+                "--max-qps", "1", "--repeats", "2", "--cooldown-seconds", "0",
+                "--slo-p95-e2e-ms", "2000",
+            ])
+        return result, runner
+
+    def test_each_http_repeat_flushes_before_requests(self):
+        actions = []
+        def flush(base_url):
+            actions.append("flush")
+            return {"status": 200}
+        def run_child(command, log_path, timeout):
+            self.assertEqual(actions[-1], "flush")
+            actions.append("requests")
+            path = Path(command[command.index("--output-file") + 1])
+            path.write_text(json.dumps(benchmark_result()))
+        with tempfile.TemporaryDirectory() as tmp:
+            directory = Path(tmp)
+            result, _ = self.run_with_flush(directory, flush, run_child)
+            self.assertEqual(result, 0)
+            self.assertEqual(actions, ["flush", "requests", "flush", "requests"])
+            summary = json.loads(next((directory / "reports").glob("*/summary.json")).read_text())
+            self.assertTrue(all(row["cache_flush"]["status"] == 200 for row in summary["history"]))
+
+    def test_failed_flush_prevents_benchmark_and_slo_acceptance(self):
+        def flush(base_url):
+            raise RuntimeError("flush refused while server is busy")
+        with tempfile.TemporaryDirectory() as tmp:
+            directory = Path(tmp)
+            result, runner = self.run_with_flush(directory, flush, lambda *args: None)
+            self.assertEqual(result, 1)
+            runner.assert_not_called()
+            summary = json.loads(next((directory / "reports").glob("*/summary.json")).read_text())
+            self.assertEqual(summary["status"], "error")
+            self.assertIsNone(summary["best_confirmed"])
+
